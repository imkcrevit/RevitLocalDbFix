<UserControl x:Class="RevitLocalDbFix.App.Controls.StepPageLayout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title + article link (SPEC §6.2 header) -->
        <DockPanel>
            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center">
                <Hyperlink x:Name="LinkArticle" Click="OnArticleClick">
                    <Run x:Name="LinkRun" />
                </Hyperlink>
            </TextBlock>
            <TextBlock x:Name="TxtTitle" Style="{StaticResource PageTitle}" />
        </DockPanel>

        <!-- Command -->
        <TextBlock Grid.Row="1" Text="{DynamicResource StepPage.Command}"
                   Style="{StaticResource SectionLabel}" Margin="0,12,0,4" />
        <TextBox Grid.Row="2" x:Name="TxtCommand" Style="{StaticResource MonoBoxLight}" />

        <!-- Raw output | expected + verdict (SPEC §6.2 split panes) -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="{DynamicResource StepPage.Raw}" Style="{StaticResource SectionLabel}" Margin="0,0,0,4" />
                <TextBox Grid.Row="1" x:Name="TxtRaw" Style="{StaticResource MonoBox}" />
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{DynamicResource StepPage.Expected}" Style="{StaticResource SectionLabel}" Margin="0,0,0,4" />
                <TextBox Grid.Row="1" x:Name="TxtExpected" Style="{StaticResource MonoBox}"
                         Background="{StaticResource MonoLightBgBrush}" Foreground="{StaticResource MonoLightFgBrush}" />
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="{DynamicResource StepPage.VerdictLabel}" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <Border x:Name="VerdictBadge" CornerRadius="10" Padding="10,3.5" Background="Transparent">
                        <TextBlock x:Name="TxtVerdict" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                    <TextBlock x:Name="TxtVerdictReason" VerticalAlignment="Center" Margin="10,0,0,0"
                               TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Note (e.g. the -v / irreversible-upgrade warnings, SPEC §6.2) -->
        <TextBlock Grid.Row="4" x:Name="TxtNote" Margin="0,10,0,0" TextWrapping="Wrap"
                   Foreground="{StaticResource WarnBrush}" Visibility="Collapsed" />

        <!-- Buttons (SPEC §6.2 bottom bar) -->
        <DockPanel Grid.Row="5" Margin="0,14,0,0">
            <Button x:Name="BtnContinue" DockPanel.Dock="Right" Style="{StaticResource AccentButton}"
                    Content="{DynamicResource Btn.Continue}" Click="OnContinue" />
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnBack" Content="{DynamicResource Btn.Back}" Click="OnBack" Margin="0,0,8,0" />
                <Button x:Name="BtnExecute" Content="{DynamicResource Btn.Execute}" Click="OnExecute" Margin="0,0,8,0" />
                <Button x:Name="BtnCopy" Content="{DynamicResource Btn.Copy}" Click="OnCopy" Margin="0,0,8,0" />
                <Button x:Name="BtnSkip" Content="{DynamicResource Btn.Skip}" Click="OnSkip" />
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
