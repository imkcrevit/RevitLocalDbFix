<UserControl x:Class="RevitLocalDbFix.App.Pages.InstancesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="140" />
        </Grid.RowDefinitions>

        <TextBlock Text="{DynamicResource Inst.Title}" Style="{StaticResource PageTitle}" />
        <TextBlock Grid.Row="1" x:Name="TxtIntro" TextWrapping="Wrap" Margin="0,6,0,4"
                   Foreground="{StaticResource TextSecondaryBrush}" />
        <TextBlock Grid.Row="2" Margin="0,0,0,10">
            <Hyperlink Click="OnArticleClick">
                <Run Text="{DynamicResource Inst.Reference}" />
            </Hyperlink>
        </TextBlock>

        <Border Grid.Row="3" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6">
            <ListView x:Name="Lv" BorderThickness="0" SelectionChanged="OnSelectionChanged">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="{DynamicResource Inst.ColProduct}" Width="120" DisplayMemberBinding="{Binding Product}" />
                        <GridViewColumn Header="{DynamicResource Inst.ColInstance}" Width="190" DisplayMemberBinding="{Binding Instance}" />
                        <GridViewColumn Header="{DynamicResource Inst.ColEngine}" Width="80" DisplayMemberBinding="{Binding Engine}" />
                        <GridViewColumn Header="{DynamicResource Inst.ColStatus}" Width="230">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{DynamicResource Inst.ColVersion}" Width="100" DisplayMemberBinding="{Binding Version}" />
                        <GridViewColumn Header="{DynamicResource Inst.ColNote}" Width="320">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Foreground="{StaticResource WarnBrush}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <TextBlock Grid.Row="4" x:Name="TxtSummary" Margin="0,8,0,0" TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondaryBrush}" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,10,0,10">
            <Button x:Name="BtnRefresh" Content="{DynamicResource Inst.Refresh}" Click="OnRefresh" Margin="0,0,8,0" />
            <Button x:Name="BtnCreate" Style="{StaticResource AccentButton}" Content="{DynamicResource Inst.Create}"
                    Click="OnCreate" IsEnabled="False" />
            <TextBlock x:Name="TxtBusy" Text="{DynamicResource Inst.Busy}" VerticalAlignment="Center" Margin="12,0,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}" Visibility="Collapsed" />
        </StackPanel>

        <TextBox Grid.Row="6" x:Name="TxtOutput" Style="{StaticResource MonoBox}" />
    </Grid>
</UserControl>
