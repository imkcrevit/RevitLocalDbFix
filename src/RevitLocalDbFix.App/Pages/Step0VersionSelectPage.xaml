<UserControl x:Class="RevitLocalDbFix.App.Pages.Step0VersionSelectPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{DynamicResource Step0.Title}" Style="{StaticResource PageTitle}" />
        <TextBlock Grid.Row="1" Text="{DynamicResource Step0.Intro}" TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,12" />

        <Border Grid.Row="2" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6">
            <ListView x:Name="Lv" BorderThickness="0" SelectionChanged="OnSelectionChanged">
                <ListView.View>
                    <GridView>
                        <GridViewColumn x:Name="ColYear" Width="62" DisplayMemberBinding="{Binding Year}" />
                        <GridViewColumn x:Name="ColProduct" Width="190" DisplayMemberBinding="{Binding Product}" />
                        <GridViewColumn x:Name="ColPath" Width="330" DisplayMemberBinding="{Binding Path}" />
                        <GridViewColumn x:Name="ColExeVersion" Width="120" DisplayMemberBinding="{Binding ExeVersion}" />
                        <GridViewColumn x:Name="ColSteel" Width="130" DisplayMemberBinding="{Binding Steel}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <TextBlock x:Name="TxtJournal" Grid.Row="3" Margin="0,10,0,0" TextWrapping="Wrap" />
        <TextBlock x:Name="TxtSysInfo" Grid.Row="4" Margin="0,4,0,10" TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondaryBrush}" />

        <StackPanel Grid.Row="5" Orientation="Horizontal">
            <Button Content="{DynamicResource Step0.Refresh}" Click="OnRefresh" Margin="0,0,8,0" />
            <Button Content="{DynamicResource Step0.Browse}" Click="OnBrowse" Margin="0,0,8,0" />
            <Button x:Name="BtnUse" Style="{StaticResource AccentButton}"
                    Content="{DynamicResource Step0.Use}" Click="OnUse" IsEnabled="False" />
        </StackPanel>
    </Grid>
</UserControl>
