<UserControl x:Class="RevitLocalDbFix.App.Pages.PlaceholderPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock x:Name="TxtTitle" Style="{StaticResource PageTitle}" />
        <TextBlock x:Name="TxtInfo" Margin="0,12,0,0" TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondaryBrush}" />
    </StackPanel>
</UserControl>
