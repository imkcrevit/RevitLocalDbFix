<Window x:Class="RevitLocalDbFix.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource App.Title}"
        Width="1160" Height="740" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBgBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="13">

    <DockPanel>

        <!-- Menu (SPEC §6.1) -->
        <Menu DockPanel.Dock="Top" Background="{StaticResource CardBgBrush}" Padding="4,2">
            <MenuItem Header="{DynamicResource Menu.File}">
                <MenuItem x:Name="MiExportReport" Header="{DynamicResource Menu.File.ExportReport}" IsEnabled="False" />
                <MenuItem Header="{DynamicResource Menu.File.OpenBackups}" Click="OnOpenBackups" />
                <MenuItem x:Name="MiRestoreSteel" Header="{DynamicResource Menu.File.RestoreSteel}" IsEnabled="False" />
                <Separator />
                <MenuItem Header="{DynamicResource Menu.File.Exit}" Click="OnExit" />
            </MenuItem>
            <MenuItem Header="{DynamicResource Menu.Language}">
                <MenuItem x:Name="MiLangEn" Header="English" IsCheckable="True" Click="OnLangEnglish" />
                <MenuItem x:Name="MiLangZh" Header="中文(简体)" IsCheckable="True" Click="OnLangChinese" />
            </MenuItem>
            <MenuItem Header="{DynamicResource Menu.Help}">
                <MenuItem x:Name="MiArticle1" Click="OnOpenArticle1" />
                <MenuItem x:Name="MiArticle2" Click="OnOpenArticle2" />
                <Separator />
                <MenuItem Header="{DynamicResource Menu.Help.About}" Click="OnAbout" />
            </MenuItem>
        </Menu>

        <!-- Header (SPEC §6.1 top bar) -->
        <Border DockPanel.Dock="Top" Background="{StaticResource CardBgBrush}"
                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1" Padding="16,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource App.Title}" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{DynamicResource App.Standalone}" FontSize="11.5" Margin="0,2,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtSelection" VerticalAlignment="Center" Margin="0,0,16,0"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <Border x:Name="AdminBadge" CornerRadius="10" Padding="9,3.5" Margin="0,0,10,0"
                            VerticalAlignment="Center" Background="{StaticResource WarnSubtleBrush}">
                        <TextBlock x:Name="TxtAdmin" FontSize="11.5" FontWeight="SemiBold" />
                    </Border>
                    <Button x:Name="BtnElevate" Style="{StaticResource AccentButton}"
                            Content="{DynamicResource Header.Elevate}" Click="OnElevate" />
                </StackPanel>
                <Grid />
            </DockPanel>
        </Border>

        <!-- Status bar (SPEC §6.1 bottom) -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource CardBgBrush}"
                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="16,5">
            <DockPanel>
                <TextBlock x:Name="TxtLog" DockPanel.Dock="Right" FontSize="11.5"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock x:Name="TxtSession" FontSize="11.5"
                           Foreground="{StaticResource TextSecondaryBrush}" />
            </DockPanel>
        </Border>

        <!-- Body: sidebar navigation + page host -->
        <Grid Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="252" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="8" Margin="0,0,12,0">
                <ListBox x:Name="NavList" Style="{StaticResource NavListBox}" SelectionChanged="OnNavSelected">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="{Binding Indent}">
                                <TextBlock Text="{Binding StatusGlyph}" Foreground="{Binding StatusBrush}"
                                           Width="18" FontWeight="Bold" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimaryBrush}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="20">
                <ContentControl x:Name="PageHost" />
            </Border>
        </Grid>

    </DockPanel>
</Window>
